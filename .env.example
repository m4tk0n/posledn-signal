# Copy this file to .env on the server.
# Never commit real credentials or secrets.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://7x.wz.cz/posledn-signal
APP_TIMEZONE=Europe/Prague

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Mandatory unique prefix for every table in this application.
DB_PREFIX=posledni_signal_

# Generate a unique random value (at least 32 bytes) for production.
# The installer also uses APP_KEY as its one-time installation key.
APP_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
